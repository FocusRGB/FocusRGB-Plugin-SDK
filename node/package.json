{
  "name": "@focusrgb/plugin-sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK and runner for FocusRGB plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "focusrgb-node-runner": "./dist/focusrgb-node-runner.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Devantix",
  "company": "Devantix",
  "copyright": "Copyright (c) 2026 Devantix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FocusRGB/FocusRGB-Plugin-SDK.git",
    "directory": "node"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
